FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL=http://localhost:3001
ARG VITE_POLL_INTERVAL_MS=30000
ARG VITE_MODBUS_SITE_IDS=
ARG VITE_MODBUS_PORT=502
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_POLL_INTERVAL_MS=$VITE_POLL_INTERVAL_MS
ENV VITE_MODBUS_SITE_IDS=$VITE_MODBUS_SITE_IDS
ENV VITE_MODBUS_PORT=$VITE_MODBUS_PORT
RUN npm run build
EXPOSE 3002
CMD ["node", "server.js"]
